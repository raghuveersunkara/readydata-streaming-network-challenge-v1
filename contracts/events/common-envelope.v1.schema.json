{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-envelope.v1.schema.json",
  "title": "ReadyData telemetry event envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "event_timestamp",
    "device_session_id",
    "sequence_number",
    "site_id",
    "device_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "device_session_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "payload": {
      "type": "object"
    }
  }
}
