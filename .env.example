# Local-development configuration only. Copy this file to .env to override
# Compose defaults. Never reuse these credentials outside this local challenge.

# Host ports
MQTT_PORT=1883
KAFKA_PORT=9092
S3_PORT=3900
NESSIE_PORT=19120
TRINO_PORT=8080
AIRFLOW_PORT=8081

# Generic S3-compatible object-storage settings
S3_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_WAREHOUSE_BUCKET=warehouse
S3_REGION=garage

# Local metadata databases
POSTGRES_ADMIN_PASSWORD=challenge_admin
NESSIE_DB_PASSWORD=nessie
AIRFLOW_DB_PASSWORD=airflow

# Local Airflow administrator and signing/encryption values
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AIRFLOW_JWT_SECRET=local-development-jwt-secret-change-me

# Supplied telemetry simulator
SIMULATOR_SEED=20250401
EVENT_RATE_MULTIPLIER=1

# Supplied MQTT-to-Kafka bridge
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
